# --- Google OAuth (server-side) ---
# Google Cloud OAuth 2.0 client credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Space-separated list of allowed redirect URIs (one must match the callback)
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# --- Session / token encryption ---
# 32+ char secret used to encrypt the stored Google refresh token at rest
TOKEN_ENCRYPTION_SECRET=

# --- App ---
# Public base URL of the app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe (billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO=
